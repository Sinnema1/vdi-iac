{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/schemas/evidence-envelope-2.json",
  "title": "Evidence Envelope, version 2",
  "description": "Common envelope for every stage's evidence. resultKind selects a closed payload definition: a payload is not an open object, so a path, an argument, raw output, or exception text cannot be smuggled through a renamed key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resultSchemaVersion",
    "resultKind",
    "runId",
    "manifestSchemaVersion",
    "startedUtc",
    "completedUtc",
    "outcome",
    "payload"
  ],
  "properties": {
    "resultSchemaVersion": {
      "enum": [
        2
      ]
    },
    "resultKind": {
      "description": "Which stage produced this. Each kind selects a closed payload definition.",
      "enum": [
        "source-qualification",
        "guest-provisioning",
        "build-orchestration"
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "manifestSchemaVersion": {
      "enum": [
        1,
        2
      ],
      "description": "Manifest version the run consumed. Required: an envelope carrying only the result version reintroduces the ambiguity version 2 exists to remove."
    },
    "startedUtc": {
      "type": "string",
      "format": "date-time"
    },
    "completedUtc": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "incomplete",
        "skipped"
      ]
    },
    "toolVersion": {
      "type": "string",
      "pattern": "^[ -~]{1,64}$"
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "resultKind": {
          "enum": [
            "source-qualification"
          ]
        },
        "payload": {
          "$ref": "#/definitions/sourceQualificationPayload"
        }
      }
    },
    {
      "properties": {
        "resultKind": {
          "enum": [
            "guest-provisioning"
          ]
        },
        "payload": {
          "$ref": "#/definitions/guestProvisioningPayload"
        }
      }
    },
    {
      "properties": {
        "resultKind": {
          "enum": [
            "build-orchestration"
          ]
        },
        "payload": {
          "$ref": "#/definitions/buildOrchestrationPayload"
        }
      }
    }
  ],
  "definitions": {
    "sourceQualificationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageCount",
        "passedCount",
        "failedRequiredCount",
        "failedOptionalCount",
        "cleanupOutcome",
        "packages"
      ],
      "properties": {
        "packageCount": {
          "type": "integer",
          "minimum": 0
        },
        "passedCount": {
          "type": "integer",
          "minimum": 0
        },
        "failedRequiredCount": {
          "type": "integer",
          "minimum": 0
        },
        "failedOptionalCount": {
          "type": "integer",
          "minimum": 0
        },
        "cleanupOutcome": {
          "enum": [
            "removed",
            "retained",
            "failed",
            "not-attempted"
          ]
        },
        "packages": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/qualificationPackage"
          }
        }
      }
    },
    "guestProvisioningPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "restartRequired",
        "packageCount",
        "passedCount",
        "failedRequiredCount",
        "cleanupOutcome",
        "packages"
      ],
      "properties": {
        "phase": {
          "enum": [
            "install",
            "validate"
          ]
        },
        "restartRequired": {
          "type": "boolean"
        },
        "packageCount": {
          "type": "integer",
          "minimum": 0
        },
        "passedCount": {
          "type": "integer",
          "minimum": 0
        },
        "failedRequiredCount": {
          "type": "integer",
          "minimum": 0
        },
        "terminalReasonCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "integrity_mismatch",
                "installer_failed",
                "installer_initiated_reboot",
                "restart_forbidden",
                "install_timeout",
                "install_timeout_termination_failed",
                "validation_failed",
                "validation_inconclusive",
                "path_rejected",
                "adapter_unsupported",
                "unexpected_error",
                "run_id_mismatch"
              ]
            }
          ]
        },
        "cleanupOutcome": {
          "description": "Guest bundle removal is ordered by the host in Stage 5, after evidence retrieval, so a phase that did not perform it records not-attempted.",
          "enum": [
            "removed",
            "retained",
            "failed",
            "not-attempted"
          ]
        },
        "packages": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/guestPackage"
          }
        }
      }
    },
    "qualificationPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "order",
        "required",
        "outcome",
        "reasonCode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "version": {
          "description": "Package version, constrained to the manifest contract's syntax -- including its rejection of moving references and wildcard segments -- so evidence cannot describe a version a manifest could never have declared.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "maxLength": 64,
          "not": {
            "pattern": "^([Ll][Aa][Tt][Ee][Ss][Tt]|[Nn][Ee][Ww][Ee][Ss][Tt]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ss][Tt][Aa][Bb][Ll][Ee]|[Hh][Ee][Aa][Dd]|[Aa][Nn][Yy])$|(^|[.+-])[xX]([.+-]|$)"
          }
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "required": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "reasonCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "source_root_not_found",
                "source_not_found",
                "source_outside_root",
                "source_link_rejected",
                "unsupported_scheme",
                "integrity_mismatch",
                "staging_failed",
                "unexpected_error"
              ]
            }
          ]
        },
        "expected": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "actual": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        }
      }
    },
    "guestPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "order",
        "required",
        "outcome",
        "reasonCode",
        "restartRequired"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "version": {
          "description": "Package version, constrained to the manifest contract's syntax -- including its rejection of moving references and wildcard segments -- so evidence cannot describe a version a manifest could never have declared.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "maxLength": 64,
          "not": {
            "pattern": "^([Ll][Aa][Tt][Ee][Ss][Tt]|[Nn][Ee][Ww][Ee][Ss][Tt]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Ss][Tt][Aa][Bb][Ll][Ee]|[Hh][Ee][Aa][Dd]|[Aa][Nn][Yy])$|(^|[.+-])[xX]([.+-]|$)"
          }
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "required": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "incomplete"
          ]
        },
        "reasonCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "integrity_mismatch",
                "installer_failed",
                "installer_initiated_reboot",
                "restart_forbidden",
                "install_timeout",
                "install_timeout_termination_failed",
                "validation_failed",
                "validation_inconclusive",
                "path_rejected",
                "adapter_unsupported",
                "unexpected_error",
                "run_id_mismatch"
              ]
            }
          ]
        },
        "restartRequired": {
          "type": "boolean"
        },
        "validation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/definitions/validationCheck"
              }
            }
          ]
        }
      }
    },
    "validationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "outcome",
        "reasonCode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "kind": {
          "enum": [
            "file-exists",
            "file-version",
            "service-exists"
          ]
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "inconclusive"
          ]
        },
        "reasonCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "file_absent",
                "version_mismatch",
                "version_unavailable",
                "service_absent",
                "root_unavailable",
                "path_rejected",
                "check_error"
              ]
            }
          ]
        }
      }
    },
    "buildOrchestrationPayload": {
      "description": "What the host observed while driving the harness. Cleanup outcomes live here because the guest phase cannot know whether its evidence was retrieved before the directory holding it was removed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packerExitCode",
        "phases",
        "hostCleanupOutcome",
        "guestCleanupOutcome"
      ],
      "properties": {
        "packerExitCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          ]
        },
        "phases": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/orchestrationPhase"
          }
        },
        "hostCleanupOutcome": {
          "enum": [
            "removed",
            "retained",
            "failed",
            "not-attempted"
          ]
        },
        "guestCleanupOutcome": {
          "description": "Reported by the harness step, or not-attempted when the run never reached it.",
          "enum": [
            "removed",
            "retained",
            "failed",
            "not-attempted"
          ]
        },
        "terminalReasonCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "bundle_assembly_failed",
                "evidence_missing",
                "evidence_duplicate",
                "evidence_malformed",
                "evidence_run_id_mismatch",
                "evidence_wrong_kind",
                "phase_missing",
                "packer_failed",
                "cleanup_failed",
                "unexpected_error"
              ]
            }
          ]
        }
      }
    },
    "orchestrationPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "outcome"
      ],
      "properties": {
        "phase": {
          "enum": [
            "install",
            "validate"
          ]
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "incomplete"
          ]
        },
        "failedRequiredCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
