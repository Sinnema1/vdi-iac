{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/schemas/transfer-descriptor-1.json",
  "title": "Transfer Descriptor, version 1",
  "description": "Everything a guest needs to act on a transfer bundle. Copied from a manifest the host already validated, never reinterpreted: the manifest does not travel. Installer and validation definitions are the manifest's own, so the descriptor cannot express anything a manifest could not.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptorVersion",
    "runId",
    "manifestSchemaVersion",
    "packages"
  ],
  "properties": {
    "descriptorVersion": {
      "description": "Version of this descriptor's own shape, distinct from the manifest version it reports.",
      "enum": [
        1
      ]
    },
    "runId": {
      "description": "Canonical lowercase UUID. Also checked semantically, because this pattern's anchors admit a trailing newline.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "manifestSchemaVersion": {
      "enum": [
        2
      ]
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "order",
        "required",
        "payloadPath",
        "sha256",
        "installer",
        "validation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "maxLength": 64
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "required": {
          "type": "boolean"
        },
        "payloadPath": {
          "description": "Path relative to the bundle root. Absolute paths and dot segments are rejected so nothing about the host layout travels with the bundle.",
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "^packages/[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "installer": {
          "oneOf": [
            {
              "$ref": "#/definitions/msiInstaller"
            },
            {
              "$ref": "#/definitions/exeInstaller"
            }
          ]
        },
        "validation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/fileExists"
              },
              {
                "$ref": "#/definitions/fileVersion"
              },
              {
                "$ref": "#/definitions/serviceExists"
              }
            ]
          }
        }
      }
    },
    "msiInstaller": {
      "description": "MSI packages supply allowlisted properties only. The executor owns the command line, so a manifest cannot pass a switch.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "timeoutSeconds",
        "restartPolicy"
      ],
      "properties": {
        "kind": {
          "enum": [
            "msi"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 32,
          "properties": {
            "ALLUSERS": {
              "description": "Per-machine versus per-user install. Printable ASCII only: control characters and non-ASCII are rejected.",
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[ -~]+$"
            },
            "INSTALLDIR": {
              "description": "Install location. Printable ASCII only: control characters and non-ASCII are rejected.",
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[ -~]+$"
            },
            "INSTALLLOCATION": {
              "description": "Install location, for packages using this spelling. Printable ASCII only: control characters and non-ASCII are rejected.",
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[ -~]+$"
            },
            "TARGETDIR": {
              "description": "Install root. Printable ASCII only: control characters and non-ASCII are rejected.",
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[ -~]+$"
            },
            "APPDIR": {
              "description": "Application directory. Printable ASCII only: control characters and non-ASCII are rejected.",
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[ -~]+$"
            }
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 7200
        },
        "restartPolicy": {
          "enum": [
            "forbid",
            "allow-deferred"
          ]
        }
      }
    },
    "exeInstaller": {
      "description": "EXE packages supply argument tokens and declare their own exit-code policy.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "timeoutSeconds",
        "restartPolicy",
        "exitCodes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exe"
          ]
        },
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[ -~]+$",
            "description": "One argument token, passed individually and never joined into a command string. Printable ASCII only: control characters and non-ASCII are rejected."
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 7200
        },
        "restartPolicy": {
          "enum": [
            "forbid",
            "allow-deferred"
          ]
        },
        "exitCodes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "success"
          ],
          "properties": {
            "success": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              }
            },
            "restartRequired": {
              "type": "array",
              "minItems": 0,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              }
            }
          }
        }
      }
    },
    "checkId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "root": {
      "description": "Allowlisted base directory. A file check never names an absolute path.",
      "enum": [
        "programFiles",
        "programFilesX86",
        "programData",
        "windows",
        "system32"
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      }
    },
    "fileExists": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "root",
        "relativePath"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/checkId"
        },
        "kind": {
          "enum": [
            "file-exists"
          ]
        },
        "root": {
          "$ref": "#/definitions/root"
        },
        "relativePath": {
          "$ref": "#/definitions/relativePath"
        }
      }
    },
    "fileVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "root",
        "relativePath",
        "versionField",
        "expectedVersion"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/checkId"
        },
        "kind": {
          "enum": [
            "file-version"
          ]
        },
        "root": {
          "$ref": "#/definitions/root"
        },
        "relativePath": {
          "$ref": "#/definitions/relativePath"
        },
        "versionField": {
          "description": "File and product versions routinely differ, so this is required rather than defaulted.",
          "enum": [
            "file",
            "product"
          ]
        },
        "expectedVersion": {
          "type": "string",
          "pattern": "^[0-9]{1,5}(\\.[0-9]{1,5}){0,3}$"
        }
      }
    },
    "serviceExists": {
      "description": "A service is not addressed by path, so this check has no root.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "serviceName"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/checkId"
        },
        "kind": {
          "enum": [
            "service-exists"
          ]
        },
        "serviceName": {
          "description": "The service key name, never the localized display name.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,80}$"
        }
      }
    }
  }
}
