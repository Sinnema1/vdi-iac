{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/schemas/transfer-descriptor-1.json",
  "title": "Transfer Descriptor, version 1",
  "description": "Everything a guest needs to act on a transfer bundle. Copied from a manifest the host already validated, never reinterpreted: the manifest does not travel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptorVersion",
    "runId",
    "manifestSchemaVersion",
    "packages"
  ],
  "properties": {
    "descriptorVersion": {
      "description": "Version of this descriptor's own shape, distinct from the manifest version it reports.",
      "enum": [
        1
      ]
    },
    "runId": {
      "description": "Canonical lowercase UUID, supplied by the orchestrator.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "manifestSchemaVersion": {
      "description": "Manifest version this descriptor was built from.",
      "enum": [
        2
      ]
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "order",
        "required",
        "payloadPath",
        "sha256",
        "installer",
        "validation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "pattern": "^[ -~]+$",
          "maxLength": 64
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "required": {
          "type": "boolean"
        },
        "payloadPath": {
          "description": "Path relative to the bundle root. Absolute paths and dot segments are rejected so nothing about the host layout travels with the bundle.",
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        },
        "sha256": {
          "description": "The value the guest verifies its payload against. Established in the manifest before runtime.",
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "installer": {
          "type": "object"
        },
        "validation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8
        }
      }
    }
  }
}
